{
  "name": "@ledgercore/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../../.env -- nest start --watch",
    "build": "nest build",
    "start": "dotenv -e ../../.env -- node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test:unit": "vitest run src",
    "test:integration": "vitest run test/integration",
    "test:concurrency": "vitest run test/concurrency",
    "dev:worker": "dotenv -e ../../.env -- nest start --watch --entryFile worker",
    "start:worker": "dotenv -e ../../.env -- node dist/worker.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.4.4",
    "@swc/core": "^1.16.13",
    "@types/express": "^5.0.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^7.2.1",
    "dotenv-cli": "^7.4.2",
    "supertest": "^7.3.1",
    "typescript": "^5.6.2",
    "unplugin-swc": "^1.6.0",
    "vitest": "^2.1.2"
  }
}
